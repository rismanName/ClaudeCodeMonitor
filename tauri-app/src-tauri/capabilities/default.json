{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the menu-bar popover",
  "windows": ["main", "popover"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "store:default",
    "updater:default",
    "process:default",
    "notification:default",
    "autostart:default"
  ]
}
